    "versions": [
      {"resource_code": "BereanStandardBible", "title": "Berean Standard Bible", "lang": "eng", "dir": "ltr", "source": "aquifer:scripture",
       "verses": [
         {"n": 1, "t": "Now Naomi had a relative on her husband’s side, a prominent man of noble character from the clan of Elimelech, whose name was Boaz."},
         {"n": 2, "t": "And Ruth the Moabitess said to Naomi, “Please let me go into the fields and glean heads of grain after someone in whose sight I may find favor.” “Go ahead, my daughter,” Naomi replied."},
         {"n": 3, "t": "So Ruth departed and went out into the field and gleaned after the harvesters. And she happened to come to the part of the field belonging to Boaz, who was from the clan of Elimelech."},
         {"n": 4, "t": "Just then Boaz arrived from Bethlehem and said to the harvesters, “The LORD be with you.” “The LORD bless you,” they replied."}
       ]},
      {"resource_code": "ArabicVanDyckBible", "title": "الكتاب المقدس، فان دايك", "lang": "arb", "dir": "rtl", "source": "aquifer:scripture",
       "verses": [
         {"n": 1, "t": "وَكَانَ لِنُعْمِي ذُو قَرَابَةٍ لِرَجُلِهَا، جَبَّارُ بَأْسٍ مِنْ عَشِيرَةِ أَلِيمَالِكَ، ٱسْمُهُ بُوعَزُ."},
         {"n": 2, "t": "فَقَالَتْ رَاعُوثُ ٱلْمُوآبِيَّةُ لِنُعْمِي: «دَعِينِي أَذْهَبْ إِلَى ٱلْحَقْلِ وَأَلْتَقِطْ سَنَابِلَ وَرَاءَ مَنْ أَجِدُ نِعْمَةً فِي عَيْنَيْهِ». فَقَالَتْ لَهَا: «ٱذْهَبِي يَابِنْتِي»."}
       ]},
      {"resource_code": "IndianRevisedVersion", "title": "Indian Revised Version", "lang": "hin", "dir": "ltr", "source": "aquifer:scripture",
       "verses": [
         {"n": 1, "t": "नाओमी के पति एलीमेलेक के कुल में उसका एक बड़ा धनी कुटुम्बी था, जिसका नाम बोअज था।"},
         {"n": 2, "t": "मोआबिन रूत ने नाओमी से कहा, “मुझे किसी खेत में जाने दे, कि जो मुझ पर अनुग्रह की दृष्टि करे, उसके पीछे-पीछे मैं सिला बीनती जाऊँ।” उसने कहा, “चली जा, बेटी।”"}
       ]},
      {"resource_code": "SBLGNT", "title": "SBL Greek New Testament", "lang": "grc", "dir": "ltr", "ref": "Matthew 1:5", "source": "aquifer:scripture",
